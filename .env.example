# Real scanner connections only; simulated scanning is disabled.
SCANNER_PROVIDER=bridge

# Configure the native TWAIN/WIA/SANE bridge when available.
SCANNER_BRIDGE_URL=http://127.0.0.1:8765
# SCANNER_BRIDGE_API_KEY=replace-with-a-long-random-secret
# SCANNER_REQUEST_TIMEOUT_MS=10000

# Replace in production. This signs DMS login sessions.
# AUTH_SECRET must be at least 32 random characters if set.
# Otherwise the provisioned .data/session-secret is used.
# For an HTTPS website on a separate server, see deployment/DEPLOYMENT.txt and
# deployment/production.env.example. DMS_PUBLIC_ORIGIN is the trusted HTTPS origin.
