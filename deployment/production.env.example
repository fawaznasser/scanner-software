# Copy to .env.production.local on the SERVER only. Never publish this file with real values.
NODE_ENV=production
DMS_PUBLIC_ORIGIN=https://dms.your-domain.example
PORT=3000
AUTH_SECRET=replace-with-a-new-random-secret-of-at-least-32-characters
# The private SSH tunnel terminates on loopback port 18765 on the server.
SCANNER_BRIDGE_URL=http://127.0.0.1:18765
# Copy the scanner computer's .data/scanner-bridge/api-key securely; do not generate a different bridge key here.
SCANNER_BRIDGE_API_KEY=replace-with-the-existing-scanner-bridge-key
SCANNER_REQUEST_TIMEOUT_MS=30000
